{
  "name": "@almadar/runtime",
  "version": "6.64.0",
  "description": "Interpreted runtime for Almadar orbital applications (OrbitalServerRuntime)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "express": false,
    "module": false,
    "@almadar/server": false,
    "./dist/createOsHandlers.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./OrbitalServerRuntime": {
      "types": "./dist/OrbitalServerRuntime.d.ts",
      "import": "./dist/OrbitalServerRuntime.js",
      "require": "./dist/OrbitalServerRuntime.js"
    },
    "./ServerBridge": {
      "types": "./dist/ServerBridge.d.ts",
      "import": "./dist/ServerBridge.js",
      "require": "./dist/ServerBridge.js"
    },
    "./createOsHandlers": {
      "types": "./dist/createOsHandlers.d.ts",
      "import": "./dist/createOsHandlers.js",
      "require": "./dist/createOsHandlers.js"
    },
    "./entityAccess": {
      "types": "./dist/entityAccess.d.ts",
      "import": "./dist/entityAccess.js",
      "require": "./dist/entityAccess.js"
    },
    "./mockRandom": {
      "types": "./dist/mockRandom.d.ts",
      "import": "./dist/mockRandom.js",
      "require": "./dist/mockRandom.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@almadar/core": "^10.75.0",
    "@almadar/evaluator": "^2.42.0",
    "@almadar/logger": "^1.11.0",
    "@almadar/server": "^2.38.0",
    "@almadar/std": "^16.194.0"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.0",
    "express": "^5.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.8.17",
    "vitest": "^2.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-runtime.git",
    "directory": "docs/packages/runtime"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "runtime",
    "orbital",
    "interpreter"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3"
}
