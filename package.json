{
  "name": "@almadar/runtime",
  "version": "6.112.0",
  "description": "Interpreted runtime for Almadar orbital applications (OrbitalServerRuntime)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "express": false,
    "module": false,
    "./dist/kernelNode.js": false,
    "./dist/kernelOsNode.js": false,
    "./dist/kernelProgram.js": false,
    "./dist/kernelWorkspace.js": false,
    "./dist/pinnedFetchNode.js": false,
    "./dist/createProgramHandlers.js": false,
    "async_hooks": false,
    "crypto": false,
    "dgram": false,
    "dns/promises": false,
    "os": false,
    "tty": false,
    "child_process": false,
    "fs": false,
    "fs/promises": false,
    "http": false,
    "net": false,
    "path": false,
    "url": false,
    "./dist/hostNode.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./OrbitalServerRuntime": {
      "types": "./dist/OrbitalServerRuntime.d.ts",
      "import": "./dist/OrbitalServerRuntime.js",
      "require": "./dist/OrbitalServerRuntime.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js",
      "require": "./dist/kernel.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js",
      "require": "./dist/credentials.js"
    },
    "./chrome": {
      "types": "./dist/chrome.d.ts",
      "import": "./dist/chrome.js",
      "require": "./dist/chrome.js"
    },
    "./chromeContent": {
      "types": "./dist/chromeContent.d.ts",
      "import": "./dist/chromeContent.js",
      "require": "./dist/chromeContent.js"
    },
    "./hostNode": {
      "types": "./dist/hostNode.d.ts",
      "import": "./dist/hostNode.js",
      "require": "./dist/hostNode.js"
    },
    "./kernelNode": {
      "types": "./dist/kernelNode.d.ts",
      "import": "./dist/kernelNode.js",
      "require": "./dist/kernelNode.js"
    },
    "./kernelOsNode": {
      "types": "./dist/kernelOsNode.d.ts",
      "import": "./dist/kernelOsNode.js",
      "require": "./dist/kernelOsNode.js"
    },
    "./kernelProgram": {
      "types": "./dist/kernelProgram.d.ts",
      "import": "./dist/kernelProgram.js",
      "require": "./dist/kernelProgram.js"
    },
    "./kernelWorkspace": {
      "types": "./dist/kernelWorkspace.d.ts",
      "import": "./dist/kernelWorkspace.js",
      "require": "./dist/kernelWorkspace.js"
    },
    "./ServerBridge": {
      "types": "./dist/ServerBridge.d.ts",
      "import": "./dist/ServerBridge.js",
      "require": "./dist/ServerBridge.js"
    },
    "./createProgramHandlers": {
      "types": "./dist/createProgramHandlers.d.ts",
      "import": "./dist/createProgramHandlers.js",
      "require": "./dist/createProgramHandlers.js"
    },
    "./mockRandom": {
      "types": "./dist/mockRandom.d.ts",
      "import": "./dist/mockRandom.js",
      "require": "./dist/mockRandom.js"
    },
    "./mockPersistence": {
      "types": "./dist/mockPersistence.d.ts",
      "import": "./dist/mockPersistence.js",
      "require": "./dist/mockPersistence.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "import": "./dist/sse.js",
      "require": "./dist/sse.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest --run",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@almadar/auth": "^0.1.3",
    "@almadar/core": "^10.128.0",
    "@almadar/db": "^0.1.5",
    "@almadar/kernel": "^18.0.0",
    "@almadar/logger": "^1.18.0",
    "@almadar/std": "^16.255.0",
    "undici": "^6.27.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@almadar-io/behaviors": "^0.16.203",
    "@almadar/eslint-plugin": "^2.22.0",
    "@almadar/orb": "^18.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.0.0",
    "express": "^5.0.0",
    "fake-indexeddb": "6.2.5",
    "semver": "^7.7.2",
    "esbuild": "0.27.7",
    "tsup": "^8.0.0",
    "turbo": "^2.8.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/almadar-runtime.git",
    "directory": "docs/packages/runtime"
  },
  "license": "BSL-1.1",
  "keywords": [
    "almadar",
    "runtime",
    "orbital",
    "interpreter"
  ],
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.19.0"
  }
}
