app vision-probe [
  version: "1.0.0",
  description: "Embeds texts on the local LM Studio embedder through std-llm.",
  egress: ["https://api.openai.com", "https://api.anthropic.com", "https://api.deepseek.com", "https://api.moonshot.ai", "https://openrouter.ai", "http://127.0.0.1:1234"]
]
orbital VisionOrbital {
  uses Llm from "std/behaviors/std-llm"

  entity EmbedRun [runtime] {
    id : string!
  }

  trait EmbedLlm = Llm.traits.LlmClient -> EmbedRun {
    config {
      provider: lmstudio
      origin: "http://127.0.0.1:1234"
      basePath: "/v1"
      model: "qwen/qwen3.8-27b"
      embedProvider: lmstudio
      embedOrigin: "http://127.0.0.1:1234"
      embedBasePath: "/v1"
      embedModel: "text-embedding-bge-base-en-v1.5"
    }
  }

  page "/embed" as EmbedPage -> EmbedLlm
}
