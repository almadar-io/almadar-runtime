the background keeps it in `system`","label":"Status slot","synonyms":"status area, slot","tier":"presentation","type":"slot"},"statusText":{"default":{"400":"Bad Request","401":"Unauthorized","402":"Payment Required","403":"Forbidden","404":"Not Found","405":"Method Not Allowed","408":"Request Timeout","409":"Conflict","410":"Gone","413":"Payload Too Large","422":"Unprocessable Entity","500":"Internal Server Error","501":"Not Implemented","502":"Bad Gateway","503":"Service Unavailable","504":"Gateway Timeout"},"description":"Reason phrase by HTTP status, used in the failure message when GitHub's error body carries no message.","items":{"type":"string"},"label":"Status texts","synonyms":"reason phrases, status names","tier":"infra","type":"Map<string,string>"},"timeoutMs":{"default":30000.0,"description":"Milliseconds each GitHub request may take before it fails as unreachable.","label":"Request timeout (ms)","synonyms":"timeout, request deadline, wait limit","tier":"infra","type":"number"},"token":{"default":"GITHUB_TOKEN","description":"Name of the credential holding the GitHub personal access token.","label":"GitHub token","synonyms":"github token, access token, pat","tier":"infra","type":"secret"}},"effectRow":[{"kind":"emit","resource":"GITHUB_COMMITS"},{"kind":"emit","resource":"GITHUB_CREATE_ISSUE_FAILED"},{"kind":"emit","resource":"GITHUB_CREATE_PR_FAILED"},{"kind":"emit","resource":"GITHUB_FILE"},{"kind":"emit","resource":"GITHUB_GET_FILE_FAILED"},{"kind":"emit","resource":"GITHUB_GET_ISSUE_FAILED"},{"kind":"emit","resource":"GITHUB_GET_PR_COMMENTS_FAILED"},{"kind":"emit","resource":"GITHUB_ISSUE"},{"kind":"emit","resource":"GITHUB_ISSUES"},{"kind":"emit","resource":"GITHUB_ISSUE_CREATED"},{"kind":"emit","resource":"GITHUB_LIST_COMMITS_FAILED"},{"kind":"emit","resource":"GITHUB_LIST_ISSUES_FAILED"},{"kind":"emit","resource":"GITHUB_PR_COMMENTS"},{"kind":"emit","resource":"GITHUB_PR_CREATED"},{"kind":"http","resource":"https://api.github.com"},{"kind":"render-ui","resource":"system"}],"emits":[{"description":"The pull request GitHub opened.","event":"GITHUB_PR_CREATED","eventId":"evt_72R1MPPJ609305C24NRS97GEHS","payloadSchema":[{"name":"number","required":true,"type":"number"},{"name":"url","required":true,"type":"string"},{"name":"html_url","required":true,"type":"string"},{"name":"title","required":true,"type":"string"},{"name":"state","required":true,"type":"string"},{"name":"draft","required":true,"type":"boolean"},{"name":"head","properties":[{"name":"ref","type":"string"}],"required":true,"type":"object"},{"name":"base","properties":[{"name":"ref","type":"string"}],"required":true,"type":"object"}],"scope":"external","synonyms":"pull request created, new pr","tier":"primary"},{"description":"Opening the pull request failed: GitHub's code (RATE_LIMIT_ERROR, AUTH_ERROR, SERVICE_ERROR, NETWORK_ERROR) and message; the code is absent when the default repository is not configured.","event":"GITHUB_CREATE_PR_FAILED","eventId":"evt_BRMT4DYGEP87B361M1XZM4XKSD","payloadSchema":[{"name":"code","type":"string"},{"name":"message","required":true,"type":"string"}],"scope":"external","synonyms":"opening the pull request failed, github error","tier":"primary"},{"description":"Internal: the createPR call's HTTP reply.","event":"GITHUB_CREATE_PR_REPLIED","eventId":"evt_A494M2MS9QCMVQTEJHPFH1ZSFQ","payloadSchema":[{"name":"status","required":true,"type":"number"},{"name":"headers","type":"Map<string,string>"},{"name":"body","required":true,"type":"string"}],"tier":"secondary"},{"description":"Internal: the createPR call never produced a reply.","event":"GITHUB_CREATE_PR_UNREACHABLE","eventId":"evt_PQK54MHS5XWJYSHATXKJ3H497G","payloadSchema":[{"name":"error","required":true,"type":"string"},{"name":"kind","required":true,"type":"string"}],"tier":"secondary"},{"description":"The review comments of the pull request.","event":"GITHUB_PR_COMMENTS","eventId":"evt_N0SS6PAK679K3WQ8WGXZA76GDH","payloadSchema":[{"entity":"GithubComment","nam